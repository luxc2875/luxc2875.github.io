@misc{LW,
  title = {Siebert's Formula for Virtual Pullbacks},
  author = {Lu, Xuanchun and Webb, Rachel},
  year = 2026,
  month = sep,
  number = {arXiv:2609.12213},
  eprint = {2609.12213},
  primaryclass = {math.AG},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2609.12213},
  abstract = {For a DM-type morphism of algebraic stacks \(f \colon X \to Y\) with a relative perfect obstruction theory \(\mathbb{E} \to \mathbb{L}_{X/Y}\) having a global resolution, we give a formula for the induced virtual pullback in terms of \(\mathbb{E}\) and \(f\). We apply our formula to prove functoriality properties of the virtual fundamental class in Gromov-Witten theory.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Algebraic Geometry},
  file = {/home/luxc/Zotero/storage/NZYQFCER/Lu and Webb - 2026 - Siebert's formula for virtual pullbacks.pdf;/home/luxc/Zotero/storage/RPPT2C3P/2609.html}
}

@misc{toricLG,
  title = {Bulk-Deformed Enumerative Mirror Symmetry for Toric {{Fano}} Surfaces},
  author = {Lu, Xuanchun},
  year = 2026,
  month = sep,
  number = {arXiv:2609.28496},
  eprint = {2609.28496},
  primaryclass = {math.AG},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2609.28496},
  abstract = {We prove a version of genus-0 mirror symmetry for toric Fano surfaces at the level of big quantum cohomology. The mirror Landau-Ginzburg model \((\check{X}, W_{\infty})\) of such a surface \(X\) can be defined in terms of counts of Maslov index two tropical or holomorphic discs with bulk insertions. While these mirror LG models are not well-defined, the Jacobian ring \(\operatorname{\mathsf{Jac}}(W_{\infty})\) of the superpotential \(W_{\infty}\) is well-defined. We show that \(\operatorname{\mathsf{Jac}}(W_{\infty})\) is isomorphic over the Novikov base to the big quantum cohomology of \(X\) using tropical methods, providing a purely algebraic analogue of the cobordism argument used in works of Fukaya-Oh-Ohta-Ono.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Algebraic Geometry,Mathematics - Symplectic Geometry},
  file = {/home/luxc/Zotero/storage/5JFC553D/Lu - 2026 - Bulk-deformed enumerative mirror symmetry for toric Fano surfaces.pdf;/home/luxc/Zotero/storage/ASPMJJ2J/2609.html}
}
