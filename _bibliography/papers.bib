@misc{toricLG,
  title = {Bulk-Deformed Enumerative Mirror Symmetry for Toric {{Fano}} Surfaces},
  author = {Lu, Xuanchun},
  year = 2026,
  month = sep,
  number = {arXiv:2609.28496},
  eprint = {2609.28496},
  primaryclass = {math.AG},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2609.28496},
  abstract = {We prove a version of genus-0 mirror symmetry for toric Fano surfaces at the level of big quantum cohomology. The mirror Landau-Ginzburg model \$(\textbackslash check\textbraceleft X\textbraceright, W\_\textbraceleft\textbackslash infty\textbraceright )\$ of such a surface \$X\$ can be defined in terms of counts of Maslov index two tropical or holomorphic discs with bulk insertions. While these mirror LG models are not well-defined, the Jacobian ring \$\textbackslash operatorname\textbraceleft\textbackslash mathsf\textbraceleft Jac\textbraceright\textbraceright (W\_\textbraceleft\textbackslash infty\textbraceright )\$ of the superpotential \$W\_\textbraceleft\textbackslash infty\textbraceright\$ is well-defined. We show that \$\textbackslash operatorname\textbraceleft\textbackslash mathsf\textbraceleft Jac\textbraceright\textbraceright (W\_\textbraceleft\textbackslash infty\textbraceright )\$ is isomorphic over the Novikov base to the big quantum cohomology of \$X\$ using tropical methods, providing a purely algebraic analogue of the cobordism argument used in works of Fukaya-Oh-Ohta-Ono.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Algebraic Geometry,Mathematics - Symplectic Geometry},
  file = {/home/luxc/Zotero/storage/5JFC553D/Lu - 2026 - Bulk-deformed enumerative mirror symmetry for toric Fano surfaces.pdf;/home/luxc/Zotero/storage/ASPMJJ2J/2609.html}
}
