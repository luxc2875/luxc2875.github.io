  eprint = {2609.12213},
  primaryclass = {math.AG},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2609.12213},
  abstract = {For a DM-type morphism of algebraic stacks \$f \textbackslash colon X \textbackslash to Y\$ with a relative perfect obstruction theory \$\textbackslash mathbb\textbraceleft E\textbraceright{} \textbackslash to \textbackslash mathbb\textbraceleft L\textbraceright\_\textbraceleft X/Y\textbraceright\$ having a global resolution, we give a formula for the induced virtual pullback in terms of \$\textbackslash mathbb\textbraceleft E\textbraceright\$ and \$f\$. We apply our formula to prove functoriality properties of the virtual fundamental class in Gromov-Witten theory.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Algebraic Geometry},
  file = {/home/luxc/Zotero/storage/NZYQFCER/Lu and Webb - 2026 - Siebert's formula for virtual pullbacks.pdf;/home/luxc/Zotero/storage/RPPT2C3P/2609.html}
